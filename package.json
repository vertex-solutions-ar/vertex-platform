{
  "name": "vertex-monorepo",
  "version": "0.9.4",
  "private": true,
  "workspaces": [
    "vertex-platform",
    "packages/shared-contracts"
  ],
  "scripts": {
    "start": "tsx scripts/dev-e2e.ts",
    "dev:e2e": "tsx scripts/dev-e2e.ts",
    "sync-context": "tsx scripts/sync-ai-context.ts",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run build --workspace=@vertex/contracts --if-present && npm run typecheck --workspaces --if-present",
    "test": "npm run test:frontend && npm run test:backend",
    "test:frontend": "npm run build --workspace=@vertex/contracts --if-present && npm run test --workspace=vertex-platform",
    "test:backend": "npm --prefix vertex-platform/functions run test",
    "qa:global": "npm run validate:rules && npm run lint && npm run typecheck",
    "validate:rules": "npm run validate:rules --workspace=vertex-platform",
    "qa:full": "npm run lint && npm run typecheck && npm run test",
    "e2e": "npm run e2e --workspace=vertex-platform",
    "e2e:run": "npm run e2e:run --workspace=vertex-platform",
    "build": "npm run build --workspace=vertex-platform && npm --prefix vertex-platform/functions run build",
    "seed:technology": "tsx scripts/seed-technology-store.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^22.5.0",
    "@angular-eslint/eslint-plugin": "^22.5.0",
    "@angular-eslint/eslint-plugin-template": "^22.5.0",
    "@angular-eslint/template-parser": "^22.0.0",
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.1",
    "@angular/common": "^22.2.1",
    "@angular/compiler": "^22.2.1",
    "@angular/core": "^22.2.1",
    "@angular/forms": "^22.2.1",
    "@angular/platform-browser": "^22.2.1",
    "@angular/router": "^22.2.1",
    "@types/node": "^22.20.4",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.61.1",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^10.5.0",
    "firebase-tools": "^15.32.1",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "@babel/core": "^7.29.7",
    "qs": ">=6.16.0",
    "browserslist": ">=4.28.8",
    "fast-uri": ">=3.1.7",
    "quill": "2.0.2",
    "uuid": "^11.1.1",
    "ws": ">=8.20.1",
    "vite": "^7.3.5",
    "esbuild": "0.28.1",
    "http-proxy-middleware": "^4.1.1",
    "piscina": "^5.2.0",
    "undici": ">=7.28.1",
    "hono": "^4.13.3",
    "ip-address": "^10.5.0",
    "js-yaml": "^4.3.1",
    "nanoid": ">=3.3.18",
    "@opentelemetry/core": ">=2.8.0",
    "tsx": {
      "esbuild": "0.28.1"
    }
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
